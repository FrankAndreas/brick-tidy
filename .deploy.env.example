# Copy to .deploy.env (gitignored) to configure scripts/deploy-nas.sh.
# Environment variables with the same names take precedence.

# SSH target: user@host, or an alias from ~/.ssh/config
NAS_HOST=admin@<NAS_IP>

# App folder on the NAS (contains compose.yaml or docker-compose.yml)
NAS_DIR=/volume1/docker/brick-tidy

# Optional: a command that prints the NAS password (the first line is used),
# for SSH login and sudo. The password is piped straight to ssh/sudo and is
# never stored, shown or logged. Without it, ssh and sudo ask interactively.
# NAS_PASS_CMD=pass show nas

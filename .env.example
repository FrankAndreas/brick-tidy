BRICKOGNIZE_URL=https://api.brickognize.com/predict/
BRICKOGNIZE_SETS_URL=https://api.brickognize.com/predict/sets/
# Optional; the CSV import works without it.
REBRICKABLE_API_KEY=
# Optional: Claude identifies the set when Brickognize is unsure or unavailable.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Recognitions and set suggestions whose best score is below this are treated as unsure.
CONFIDENCE_THRESHOLD=0.5
DATA_DIR=./data

BRICKOGNIZE_URL=https://api.brickognize.com/predict/
BRICKOGNIZE_SETS_URL=https://api.brickognize.com/predict/sets/
# Optional; the CSV import works without it. When set, BrickLink part IDs from
# Brickognize that the catalog does not know (e.g. 4073) are looked up (-> 6141).
REBRICKABLE_API_KEY=
# Optional: an AI identifies the set, and bricks, when Brickognize is unsure or unavailable.
# AI_PROVIDER: infomaniak | claude | none. Left empty: Infomaniak if its token and product ID
# are set, else Claude if ANTHROPIC_API_KEY is set, else the AI is off.
AI_PROVIDER=
# Infomaniak AI (processed in Switzerland): a token with only the ai-tools scope, a lifetime,
# and a spending limit at Infomaniak. The same variables as in meal-planer.
INFOMANIAK_AI_TOKEN=
INFOMANIAK_AI_PRODUCT_ID=
AI_MODEL=google/gemma-4-31B-it
# Claude (Anthropic).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Recognitions and set suggestions whose best score is below this are treated as unsure.
CONFIDENCE_THRESHOLD=0.5
DATA_DIR=./data
